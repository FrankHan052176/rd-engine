+/// Same-directory staging, checked sync and atomic replace under the caller's
+/// CHECKED_HOST_WRITER guard. The deadline guard runs after staging and platform
+/// path preparation, immediately before the replace syscall.
+/// A later directory-sync failure cannot undo a successful replace.
+fn checked_host_store<T: serde::Serialize>(
+    path: &Path,
+    value: &T,
+    replace: bool,
+    before_replace: impl FnOnce() -> Result<()>,
+) -> Result<()> {
+    let parent = path.parent().ok_or_else(|| anyhow!("Invalid host configuration location"))?;
+    fs::create_dir_all(parent).map_err(|_| anyhow!("Unable to prepare host configuration directory"))?;
+    let temporary = parent.join(format!(".host-{}.tmp", uuid::Uuid::new_v4()));
+    struct Staged(PathBuf);
+    impl Drop for Staged { fn drop(&mut self) { let _ = fs::remove_file(&self.0); } }
+    let staged = Staged(temporary);
+    let mut options = fs::OpenOptions::new();
+    options.create_new(true).write(true);
+    #[cfg(unix)]
+    { use std::os::unix::fs::OpenOptionsExt; options.mode(0o600); }
+    let mut file = options.open(&staged.0).map_err(|_| anyhow!("Unable to stage host configuration"))?;
+    let mut bytes = toml::to_string(value).map_err(|_| anyhow!("Unable to encode host configuration"))?.into_bytes();
+    let written = file.write_all(&bytes).and_then(|()| file.sync_all());
+    sodiumoxide::utils::memzero(&mut bytes);
+    written.map_err(|_| anyhow!("Unable to flush host configuration"))?;
+    drop(file);
+    checked_host_replace(&staged.0, path, replace, before_replace)?;
+    #[cfg(unix)]
+    fs::File::open(parent).and_then(|file| file.sync_all()).map_err(|_| anyhow!("Unable to sync host configuration directory"))?;
+    Ok(())
+}
