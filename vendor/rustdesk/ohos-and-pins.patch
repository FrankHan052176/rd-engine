+    pub fn checked_host_commit(prepared: PreparedHostConfig) -> Result<CheckedHostConfig> {
+        let _writer = CHECKED_HOST_WRITER.lock().map_err(|_| anyhow!("Host configuration writer unavailable"))?;
+        let uuid = checked_host_machine_uuid().unwrap_or_else(|| prepared.identity.key_pair.1.clone());
+        if uuid != prepared.config.registration_uuid { return Err(anyhow!("Official device UUID changed during checked initialization")); }
