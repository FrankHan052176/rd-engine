+    /// The caller serializes this with credential revision publication. Success
+    /// means the checked atomic file replacement completed, not a cache write.
+    /// The pre-replace guard runs after staging under the configuration locks;
+    /// it must not re-enter configuration or host-owner locks.
+    pub fn checked_set_permanent_password(
+        password: &str,
+        before_replace: impl FnOnce() -> Result<()>,
+    ) -> Result<()> {
+        let _writer = CHECKED_HOST_WRITER.lock().map_err(|_| anyhow!("Host configuration writer unavailable"))?;
+        if Self::is_disable_change_permanent_password() { return Err(anyhow!("Permanent password changes are disabled")); }
+        let mut current = CONFIG.write().map_err(|_| anyhow!("Identity cache unavailable"))?;
+        let stored = checked_host_read::<Config>(&Self::file())?.ok_or_else(|| anyhow!("Host identity file disappeared"))?;
+        if stored.key_pair != current.key_pair || stored.salt != current.salt || stored.password != current.password
+            || stored.enc_id != current.enc_id || !stored.id.is_empty() && stored.id != current.id {
+            return Err(anyhow!("Existing credential configuration changed; refresh is required"));
+        }
+        let mut next = current.clone();
+        if next.salt.is_empty() { return Err(anyhow!("Checked password salt unavailable")); }
