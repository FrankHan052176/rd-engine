+    ) -> Result<()> {
+        let _writer = CHECKED_HOST_WRITER.lock().map_err(|_| anyhow!("Host configuration writer unavailable"))?;
+        options.remove("allow-remote-cm-modification");
+        if OVERWRITE_SETTINGS.read().map_err(|_| anyhow!("Options policy unavailable"))?.iter()
+            .any(|(key, value)| options.get(key).is_some_and(|requested| requested != value)) {
+            return Err(anyhow!("Host option is locked by deployment policy"));
+        }
+        Self::purify_options(&mut options);
