+        *CHECKED_CONFIG_SEED.lock().map_err(|_| anyhow!("Identity cache unavailable"))? = Some(prepared.identity.clone());
+        let mut identity = CONFIG.write().map_err(|_| anyhow!("Identity cache unavailable"))?;
+        *CHECKED_CONFIG2_SEED.lock().map_err(|_| anyhow!("Options cache unavailable"))? = Some(prepared.options.clone());
+        let mut options = CONFIG2.write().map_err(|_| anyhow!("Options cache unavailable"))?;
+        *CHECKED_LOCAL_CONFIG_SEED.lock().map_err(|_| anyhow!("Local options cache unavailable"))? = Some(prepared.local.clone());
+        let mut local = LOCAL_CONFIG.write().map_err(|_| anyhow!("Local options cache unavailable"))?;
