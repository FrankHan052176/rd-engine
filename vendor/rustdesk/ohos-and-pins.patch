+fn checked_host_read<T: serde::de::DeserializeOwned>(path: &Path) -> Result<Option<T>> {
+    let mut file = match fs::File::open(path) {
+        Ok(file) => file,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(anyhow!("Unable to read existing host configuration")),
+    };
+    if file.metadata()?.len() > 1024 * 1024 { return Err(anyhow!("Host configuration is too large")); }
+    let mut text = String::new();
+    file.read_to_string(&mut text).map_err(|_| anyhow!("Invalid host configuration encoding"))?;
+    if text.trim().is_empty() { return Err(anyhow!("Existing host configuration is empty or truncated")); }
+    let value: toml::Value = toml::from_str(&text).map_err(|_| anyhow!("Malformed existing host configuration"))?;
+    for key in ["id", "enc_id", "password", "salt", "rendezvous_server", "unlock_pin", "trusted_devices"] {
+        if value.get(key).is_some_and(|value| !value.is_str()) { return Err(anyhow!("Invalid host configuration field")); }
+    }
+    if let Some(pair) = value.get("key_pair") {
+        let pair = pair.as_array().ok_or_else(|| anyhow!("Invalid stored identity keypair"))?;
+        if pair.len() != 2 || pair.iter().any(|part| part.as_array().is_none_or(|bytes|
+            bytes.iter().any(|byte| byte.as_integer().is_none_or(|byte| !(0..=255).contains(&byte))))) {
+            return Err(anyhow!("Invalid stored identity keypair"));
+        }
+    }
+    if let Some(options) = value.get("options") {
+        if options.as_table().is_none_or(|options| options.values().any(|value| !value.is_str())) {
+            return Err(anyhow!("Invalid stored host options"));
+        }
+    }
+    let result = toml::from_str(&text).map(Some).map_err(|_| anyhow!("Malformed existing host configuration"));
+    unsafe { sodiumoxide::utils::memzero(text.as_bytes_mut()); }
+    result
+}
+
+fn checked_host_key_pair(pair: &KeyPair) -> Result<(sign::SecretKey, sign::PublicKey)> {
+    let sk = sign::SecretKey::from_slice(&pair.0).ok_or_else(|| anyhow!("Invalid existing signing key"))?;
+    let pk = sign::PublicKey::from_slice(&pair.1).ok_or_else(|| anyhow!("Invalid existing public key"))?;
+    let proof = b"rd-engine checked existing host identity";
+    if !sign::verify_detached(&sign::sign_detached(proof, &sk), proof, &pk) {
+        return Err(anyhow!("Existing signing keypair does not match"));
+    }
+    Ok((sk, pk))
+}
