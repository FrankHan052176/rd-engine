+        *identity = prepared.identity;
+        *options = prepared.options;
+        *local = prepared.local;
+        *CHECKED_CONFIG_SEED.lock().map_err(|_| anyhow!("Identity cache unavailable"))? = None;
+        *CHECKED_CONFIG2_SEED.lock().map_err(|_| anyhow!("Options cache unavailable"))? = None;
+        *CHECKED_LOCAL_CONFIG_SEED.lock().map_err(|_| anyhow!("Local options cache unavailable"))? = None;
