+#[cfg(windows)]
+fn checked_host_replace(
+    from: &Path,
+    to: &Path,
+    replace: bool,
+    before_replace: impl FnOnce() -> Result<()>,
+) -> Result<()> {
+    use std::os::windows::ffi::OsStrExt;
+    #[link(name = "kernel32")]
+    unsafe extern "system" { fn MoveFileExW(from: *const u16, to: *const u16, flags: u32) -> i32; }
+    let from: Vec<u16> = from.as_os_str().encode_wide().chain(Some(0)).collect();
+    let to: Vec<u16> = to.as_os_str().encode_wide().chain(Some(0)).collect();
+    // WRITE_THROUGH; no COPY_ALLOWED. First creation must not overwrite a race.
+    let flags = 0x8 | if replace { 0x1 } else { 0 };
+    before_replace()?;
+    if unsafe { MoveFileExW(from.as_ptr(), to.as_ptr(), flags) } == 0 {
+        Err(anyhow!("Unable to commit host configuration"))
+    } else { Ok(()) }
+}
+#[cfg(not(windows))]
+fn checked_host_replace(
+    from: &Path,
+    to: &Path,
+    replace: bool,
+    before_replace: impl FnOnce() -> Result<()>,
+) -> Result<()> {
+    before_replace()?;
+    (if replace { fs::rename(from, to) } else { fs::hard_link(from, to) })
+        .map_err(|_| anyhow!("Unable to commit host configuration"))
+}
 
