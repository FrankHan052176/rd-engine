+fn checked_host_decrypt(storage: &str, uuid: &[u8], pk: &[u8]) -> Result<String> {
+    if storage.starts_with(PASSWORD_ENC_VERSION) {
+        permanent_password::checked_decrypt(storage, PASSWORD_ENC_VERSION, uuid, pk)
+    } else { Ok(storage.to_owned()) }
+}
