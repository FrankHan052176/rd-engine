      }
    ],
    "recorded_steps": [
      {
        "patch": "enumeration-only.patch",
        "patch_sha256": "8a9f79f8ad6f0700a93165125198307ffb82c256058121f10808984a24fc77b5",
        "purpose": "Unix interfaces() delegates directly to the published unix_interfaces/getifaddrs path, avoiding local-IP/default-gateway and ancillary enrichment. Windows removes gateway enumeration, SendARP/helper and INCLUDE_GATEWAYS while retaining GetAdaptersAddresses interface/IP/MAC extraction. BSD/macOS AF_LINK types remain untouched."
      },
      {
        "patch": "windows-allocation.patch",
        "patch_sha256": "3f0a61ed58caf8ad20dc40ce6b5411aac38baa0f06922139fb02ea182153f22a",
        "purpose": "After enumeration-only.patch, keep pointer and actual allocated_size in a drop owner. API-mutated dwsize is only the requested next allocation size. Reallocation drops the prior owner with its original size; failure/success/unwind release each allocation exactly once."
      }
    ],
    "manifest_selection": {
      "default-net": {
        "version": "=0.14.1",
        "path": "vendor/default-net"
      }
    },
    "caller": "src/lan/discovery.rs; scanner only calls get_interfaces()",
    "lock_owner": "Main resolves the three active workspace Cargo.lock files. The vendored Cargo.lock is an unchanged archive member, not a hand-authored resolver update."
  },
  "provenance_boundary": "All 34 published files are retained, including published source/license/README/examples/manifest/lock. This import is the crates.io byte baseline, not a claim that normalized Cargo.toml equals the source repository. Original gateway APIs remain upstream source but are not reached from scanner get_interfaces().",
  "verification": {
    "performed": [
      "Downloaded official crates.io archive over HTTPS and compared its SHA-256 to the fixed RustDesk official lock checksum.",
      "Compared retained files against the archive bytes; only the two recorded interface source files differ.",
      "Recorded separate enumeration-only and Windows allocation ownership patches plus their combined original-to-final patch.",
      "Read memalloc 0.1.0 and Windows 0.32.0 GetAdaptersAddresses flags/default signatures; no API guessed or upgraded."
    ],
    "not_performed": [
      "No compilation, linking, tests, linters, formatters, scanning, device operations or app execution.",
      "No target support, ordinary OHOS app permissions, actual interface enumeration or Windows failure-path runtime claim."
    ]
