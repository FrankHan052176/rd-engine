+import 'dart:async';
+
+import '../models/platform_model.dart';
+
+/// A retired account operation must not publish data, including error/loading
+/// state, into the account that replaced it. Never include credentials in this
+/// exception: callers may display it or record it in diagnostics.
+class AccountChanged implements Exception {
+  const AccountChanged();
+
+  @override
+  String toString() => 'Account changed; operation cancelled';
+}
+
+/// Unwrap after the caller's await, not in the producer's last microtask.
+/// This closes the gap between completing a Future and resuming its consumer.
+class AccountResult<T> {
+  final AccountLease _account;
+  final T _value;
+  AccountResult._(this._account, this._value);
+
+  T get value {
+    _account.check();
+    return _value;
+  }
+}
+
+class AccountLease {
+  final String apiServer;
+  final String token;
+  final int _generation;
+  final bool _authentication;
+  final String _rendezvousServer;
+  final String _serverKey;
+  final bool Function()? _ownerIsCurrent;
+
+  AccountLease._(this.apiServer, this.token, this._generation,
+      this._authentication, this._rendezvousServer, this._serverKey,
+      this._ownerIsCurrent);
+
+  bool get isCurrent => AccountLifecycle._generationIsCurrent(_generation) &&
+      (_ownerIsCurrent?.call() ?? true) &&
+      (_authentication ||
+          token == bind.mainGetLocalOption(key: 'access_token'));
+
+  void check() {
+    if (!isCurrent) throw const AccountChanged();
+  }
+
+  Future<void> validate() async {
+    check();
+    final api = await bind.mainGetApiServer();
+    final rendezvous = await bind.mainGetOption(key: 'custom-rendezvous-server');
+    final key = await bind.mainGetOption(key: 'key');
+    check();
+    if (api != apiServer || rendezvous != _rendezvousServer || key != _serverKey) {
+      throw const AccountChanged();
+    }
+  }
+
+  /// Check both successful and failed awaits before the caller touches models.
+  Future<AccountResult<T>> wait<T>(Future<T> operation) async {
+    try {
+      final result = await operation;
+      await validate();
+      return AccountResult._(this, result);
+    } catch (_) {
+      await validate();
+      rethrow;
+    }
+  }
+}
+
+/// Only account work uses this queue; peer/media workers are not serialized.
+/// Transitions retire Dart work immediately, then drain native writes already
+/// submitted by that work before replacing/revoking the account. Logout alone
+/// also waits for its bounded old-server request before retiring native state.
+class AccountLifecycle {
+  static int _generation = 0;
+  static Future<void> _tail = Future<void>.value();
+  static int _queued = 0;
+  static final Object _queueKey = Object();
+  static final Object _generationKey = Object();
+  static final Object _transitionKey = Object();
+  static Set<Future<void>>? _nestedWrites;
+  static Object? _activeQueueOwner;
+  static const _maxQueued = 64;
+
+  static bool get _insideQueue => _activeQueueOwner != null &&
+      identical(Zone.current[_queueKey], _activeQueueOwner);
+
+  static bool _generationIsCurrent(int generation) => generation == _generation ||
+      (_insideQueue && Zone.current[_transitionKey] == true &&
+          Zone.current[_generationKey] == generation);
+
+  static Future<AccountLease> capture({bool authentication = false,
+      bool Function()? ownerIsCurrent}) async {
+    final generation = _insideQueue
+        ? Zone.current[_generationKey] as int : _generation;
+    if (!_insideQueue) await _tail;
+    if (!_generationIsCurrent(generation)) throw const AccountChanged();
+    final api = await bind.mainGetApiServer();
+    final rendezvous = await bind.mainGetOption(key: 'custom-rendezvous-server');
+    final key = await bind.mainGetOption(key: 'key');
+    if (!_generationIsCurrent(generation)) throw const AccountChanged();
+    final token = bind.mainGetLocalOption(key: 'access_token');
+    return AccountLease._(api, token, generation, authentication, rendezvous, key,
+        ownerIsCurrent);
+  }
+
+  static Future<T> _enqueue<T>(Future<T> Function() action,
+      {required int generation, bool transition = false}) {
+    if (_queued >= _maxQueued) {
+      return Future<T>.error(StateError('Account operation queue is full'));
+    }
+    _queued++;
+    if (_insideQueue) {
+      final pending = _nestedWrites!;
+      final result = Future<T>.sync(action);
+      late final Future<void> settled;
+      settled = result.then<void>((_) {}, onError: (Object _, StackTrace __) {})
+          .whenComplete(() {
+        pending.remove(settled);
+        _queued--;
+      });
+      pending.add(settled);
+      return result;
+    }
+    final result = _tail.then((_) async {
+      final owner = Object();
+      final pending = <Future<void>>{};
+      _activeQueueOwner = owner;
+      _nestedWrites = pending;
+      try {
+        return await runZoned(action, zoneValues: {
+          _queueKey: owner,
+          _generationKey: generation,
+          _transitionKey: transition,
+        });
+      } finally {
+        // A synchronous model listener may have submitted another native
+        // write. Drain it as well before admitting the next transition.
+        while (pending.isNotEmpty) {
+          await Future.wait(pending.toList());
+        }
+        _nestedWrites = null;
+        _activeQueueOwner = null;
+        _queued--;
+      }
+    });
+    // The caller retains the error; a failed write must not poison the queue.
+    _tail = result.then<void>((_) {}, onError: (Object _, StackTrace __) {});
+    return result;
+  }
+
+  static Future<T> write<T>(
+      AccountLease account, Future<T> Function() action) {
+    account.check();
+    return _enqueue(() async {
+      await account.validate();
+      account.check();
+      return action();
+    }, generation: account._generation);
+  }
+
+  static Future<T> transition<T>(Future<T> Function() action) {
+    if (_insideQueue) return action();
+    // Do not retire an account for a transition we cannot enqueue.
+    if (_queued >= _maxQueued) {
+      return Future<T>.error(StateError('Account operation queue is full'));
+    }
+    final generation = ++_generation;
+    // Transitions themselves run FIFO even if another is already queued: an
+    // intervening no-change settings save must not silently discard logout.
+    // Their captured leases cease to be usable outside this queue owner.
+    return _enqueue(action, generation: generation, transition: true);
+  }
+
+  /// Dialog cancellation retires its own continuations, not an already
+  /// committed native login and never a newer dialog's authentication.
+  static void retire(AccountLease account) {
+    if (account._generation == _generation) _generation++;
+  }
+}
