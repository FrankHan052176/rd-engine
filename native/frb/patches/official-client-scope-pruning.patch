-        _nextTerminalId = terminalId + 1;
-      }
-      tabController.add(_createTerminalTab(
-        peerId: peerId,
-        terminalId: newTerminalId,
-        password: page.password,
-        isSharedPassword: page.isSharedPassword,
-        forceRelay: page.forceRelay,
-        connToken: page.connToken,
-      ));
-    }
-  }
