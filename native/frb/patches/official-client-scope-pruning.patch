-        send = '\x1B[A';
-        break;
-      case '↓':
-        send = '\x1B[B';
-        break;
-      case '→':
-        send = '\x1B[C';
-        break;
-      case '←':
-        send = '\x1B[D';
-        break;
-
-      case 'Home':
-        send = '\x1B[H';
