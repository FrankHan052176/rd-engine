+      origin.check();
+      return origin;
+    }
+    final generation = _insideQueue
+        ? Zone.current[_generationKey] as int : _generation;
+    if (!_insideQueue) await _tail;
+    if (!_generationIsCurrent(generation)) throw const AccountChanged();
+    final view = await _snapshot();
+    if (!_generationIsCurrent(generation)) throw const AccountChanged();
+    return AccountLease._(view, generation, authentication, cacheKind, ownerIsCurrent);
+  }
+
+  static Future<T> run<T>(AccountLease account, Future<T> Function() action) {
+    account.check();
+    return runZoned(action, zoneValues: {_operationKey: account});
+  }
+
+  static AccountLease forCache(AccountLease account, String kind,
+      {bool Function()? ownerIsCurrent}) {
+    account.check();
+    return AccountLease._(account._view, account._generation, false, kind,
+        ownerIsCurrent);
+  }
+
+  // Rebase only Dart scheduling ownership for an intentional transition.
+  // The native receipt/API/token and kind receipts remain the ORIGINAL view.
+  static AccountLease transitionOrigin(AccountLease account) {
+    if (!_insideQueue || Zone.current[_transitionKey] != true) {
+      throw StateError('Account transition owner missing');
+    }
+    if (account._retired) throw const AccountChanged();
+    return AccountLease._(account._view, Zone.current[_generationKey] as int,
+        true, null, null);
+  }
+
+  static Future<T> _enqueue<T>(Future<T> Function() action,
+      {required int generation, bool transition = false}) {
+    if (_queued >= _maxQueued) {
+      return Future<T>.error(StateError('Account operation queue is full'));
+    }
+    _queued++;
+    if (_insideQueue) {
+      final pending = _nestedWrites!;
+      final result = Future<T>.sync(action);
+      late final Future<void> settled;
+      settled = result.then<void>((_) {}, onError: (Object _, StackTrace __) {})
+          .whenComplete(() {
+        pending.remove(settled);
+        _queued--;
+      });
+      pending.add(settled);
+      return result;
+    }
+    final result = _tail.then((_) async {
+      final owner = Object();
+      final pending = <Future<void>>{};
+      _activeQueueOwner = owner;
+      _nestedWrites = pending;
+      try {
+        return await runZoned(action, zoneValues: {
+          _queueKey: owner,
+          _generationKey: generation,
+          _transitionKey: transition,
+        });
+      } finally {
+        // A synchronous model listener may have submitted another native
+        // write. Drain it as well before admitting the next transition.
+        while (pending.isNotEmpty) {
+          await Future.wait(pending.toList());
+        }
+        _nestedWrites = null;
+        _activeQueueOwner = null;
+        _queued--;
+      }
+    });
+    // The caller retains the error; a failed write must not poison the queue.
+    _tail = result.then<void>((_) {}, onError: (Object _, StackTrace __) {});
+    return result;
+  }
+
+  static Future<T> write<T>(AccountLease account, Future<T> Function() action) {
+    account.check();
+    return _enqueue(() async {
+      await account.validate();
+      account.check();
+      return action();
+    }, generation: account._generation);
+  }
+
+  static Future<T> transition<T>(Future<T> Function() action) {
+    if (_insideQueue && Zone.current[_transitionKey] == true) return action();
+    if (_queued >= _maxQueued) {
+      return Future<T>.error(StateError('Account operation queue is full'));
+    }
+    final generation = ++_generation;
+    return _enqueue(() => runZoned(action, zoneValues: {_operationKey: null}),
+        generation: generation, transition: true);
+  }
+
+  static void retire(AccountLease account) {
+    if (account._generation == _generation) _generation++;
+  }
+}
