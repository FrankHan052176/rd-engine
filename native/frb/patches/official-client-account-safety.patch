+import 'dart:async';
+import 'dart:convert';
+
+import 'account_native.dart' if (dart.library.html) 'account_web.dart' as bridge;
+
+class AccountChanged implements Exception {
+  const AccountChanged();
+  @override
+  String toString() => 'Account changed; operation cancelled';
+}
+
+// Native snapshots are atomic, secret-bearing business results. Never include
+// one in diagnostics. The web bridge has no native receipts and stays separate.
+class _AccountView {
+  final String api;
+  final String token;
+  final String userInfo;
+  final String? receipt;
+  final Map<String, String> cacheReceipts;
+
+  _AccountView(Map<String, dynamic> data)
+      : api = data['api_server'] as String,
+        token = data['access_token'] as String,
+        userInfo = data['user_info'] as String,
+        receipt = bridge.nativeAccount ? data['receipt'] as String : null,
+        cacheReceipts = bridge.nativeAccount
+            ? Map<String, String>.from(data['cache_receipts']) : {} {
+    if (bridge.nativeAccount && (receipt!.isEmpty ||
+        (cacheReceipts['ab'] ?? '').isEmpty ||
+        (cacheReceipts['group'] ?? '').isEmpty)) {
+      throw const FormatException('Invalid account snapshot');
+    }
+  }
+}
+
+class AccountResult<T> {
+  final AccountLease _account;
+  final T _value;
+  AccountResult._(this._account, this._value);
+
+  // Check after resuming the consumer, not only in the producer's microtask.
+  T get value {
+    _account.check();
+    return _value;
+  }
+}
+
+// A populated model keeps this value, never a lease's shared mutable view.
+// Native kind receipts already bind the account epoch and that kind's revision;
+// metadata and the other cache kind are deliberately not part of this stamp.
+class AccountCacheOrigin {
+  final String _api;
+  final String _token;
+  final int _generation;
+  final String _kind;
+  final String? _receipt;
+
+  AccountCacheOrigin._(AccountLease account, this._kind, this._receipt)
+      : _api = account.apiServer,
+        _token = bridge.nativeAccount ? '' : account.token,
+        _generation = account._generation;
+
+  bool matches(AccountLease account) => account._cacheKind == _kind &&
+      account.apiServer == _api &&
+      (bridge.nativeAccount
+          ? account._view.cacheReceipts[_kind] == _receipt
+          : account.token == _token && account._generation == _generation);
+}
+
+class AccountLease {
+  _AccountView _view;
+  final int _generation;
+  final bool _authentication;
+  final String? _cacheKind;
+  final bool Function()? _ownerIsCurrent;
+  bool _retired = false;
+  String? _authAttempt;
+  bool _hasAuthAttempt = false;
+
+  bool get hasAuthAttempt => _hasAuthAttempt;
+
+  AccountLease._(this._view, this._generation, this._authentication,
+      this._cacheKind, this._ownerIsCurrent);
+
+  String get apiServer => _view.api;
+  String get token => _view.token;
+  String get userInfo => _view.userInfo;
+  bool get isCurrent => !_retired &&
+      AccountLifecycle._generationIsCurrent(_generation) &&
+      (_ownerIsCurrent?.call() ?? true);
+
+  bool sameAccount(AccountLease other) => bridge.nativeAccount
+      ? _view.receipt == other._view.receipt
+      : apiServer == other.apiServer && token == other.token;
+
+  AccountCacheOrigin get cacheOrigin {
+    check();
+    final kind = _cacheKind;
+    if (kind == null) throw StateError('Cache lease kind missing');
+    return AccountCacheOrigin._(this, kind, _view.cacheReceipts[kind]);
+  }
+
+  void check() {
+    if (!isCurrent) throw const AccountChanged();
+  }
+
+  Never _changed() {
+    _retired = true;
+    throw const AccountChanged();
+  }
+
