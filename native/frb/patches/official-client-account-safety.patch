diff --git a/lib/utils/account_web.dart b/lib/utils/account_web.dart
new file mode 100644
--- /dev/null
+++ b/lib/utils/account_web.dart
@@ -0,0 +1,45 @@
+import '../models/platform_model.dart';
+
+// The web client retains its existing JavaScript business bridge. There is no
+// native receipt, fabricated receipt, or native protected-store fallback here.
+const nativeAccount = false;
+
+Future<Map<String, dynamic>> snapshot() async {
+  final api = await bind.mainGetApiServer();
+  return {
+    'api_server': api,
+    'access_token': bind.mainGetLocalOption(key: 'access_token'),
+    'user_info': bind.mainGetLocalOption(key: 'user_info'),
+  };
+}
+
+Future<String?> setLocalOption(String? receipt, String key, String value) async {
+  await bind.mainSetLocalOption(key: key, value: value);
+  return null;
+}
+
+Future<String?> cache(String? receipt, String kind, String operation, String? value) async {
+  if (kind == 'ab') {
+    switch (operation) {
+      case 'load': return bind.mainLoadAb();
+      case 'save': await bind.mainSaveAb(json: value!); return null;
+      case 'clear': await bind.mainClearAb(); return null;
+    }
+  } else if (kind == 'group') {
+    switch (operation) {
+      case 'load': return bind.mainLoadGroup();
+      case 'save': await bind.mainSaveGroup(json: value!); return null;
+      case 'clear': await bind.mainClearGroup(); return null;
+    }
+  }
+  throw const FormatException('Invalid account cache operation');
+}
+
+Future<String?> authStart(String? receipt, String op, bool rememberMe) {
+  // Invoke before returning a Future: Safari requires the original gesture.
+  final started = bind.mainAccountAuth(op: op, rememberMe: rememberMe);
+  return started.then((_) => null);
+}
+
+Future<void> authCancel(String? attempt) => bind.mainAccountAuthCancel();
+Future<String> authResult(String? attempt) => bind.mainAccountAuthResult();
