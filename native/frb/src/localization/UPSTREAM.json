  "source_excerpts": {
    "src/ui_interface.rs::get_langs": {
      "source_url": "https://github.com/rustdesk/rustdesk/blob/092a961b629d318fe290eeafac0cd214a1e9deeb/src/ui_interface.rs#L902-L913",
      "source_git_blob_sha1": "b1eeefde2e6a1fa76719766ff4ea8594b90aa61f",
      "original_lines": [
        902,
        913
      ],
      "original_sha256": "3ba44e31fd0ca69fc7737544444cba060ef04f6876c4ce142dd8c777d9ca3052",
      "original_source": "#[inline]\npub fn get_langs() -> String {\n    use serde_json::json;\n    let hide_cjk = crate::lang::cjk_ui_unavailable();\n    let mut x: Vec<(&str, String)> = crate::lang::LANGS\n        .iter()\n        .filter(|a| !hide_cjk || !crate::lang::is_cjk_lang(a.0))\n        .map(|a| (a.0, format!(\"{} ({})\", a.1, a.0)))\n        .collect();\n    x.sort_by(|a, b| a.0.cmp(b.0));\n    json!(x).to_string()\n}\n",
      "integrated_path": "mod.rs",
      "integrated_symbol": "langs",
      "adaptation": "Preserve pinned filter, display-name format and language-code ordering. Return pairs without serialization; the existing FRB main_get_langs Result<String> uses fallible serde_json serialization. Module paths and local variable names only are adapted."
    }
  },
  "local_files": {
    "mod.rs": {
      "bytes": 642,
      "sha256": "40c7fca86615edfbe95a96bf0c3e47fd73ace98ec8b36f1c5dfc289ac3c4ce16",
      "purpose": "Local module wiring and the explicitly recorded pinned get_langs excerpt adaptation; mounts upstream/lang.rs, reexports both translation entrypoints and returns the official filtered, formatted, sorted language list."
    }
  },
  "integration": {
    "patch": "integration.patch",
    "bytes": 18365,
    "sha256": "a34eebae75038e93429ead8d7a40ba72010143dcae5ba1de914aa750ab8dc3b0",
    "patch_root": "native/frb/src/localization",
    "path_mapping": "src/lang.rs -> upstream/lang.rs; src/lang/*.rs -> upstream/lang/*.rs; LICENCE -> upstream/LICENCE.",
    "original_hashes": "source_files.bytes, source_files.sha256 and source_files.git_blob_sha1 describe the full original Git blob. integrated_bytes and integrated_sha256 describe the checked-in adapted bytes at path. Reverse-applying the patch at patch_root reproduces every original blob, including the omitted upstream test module. mod.rs is local wiring, not an upstream file.",
    "reverse_check_from_repository_root": "git apply --check --reverse --directory=native/frb/src/localization native/frb/src/localization/integration.patch",
    "adaptations": [
      {
        "id": "I18N1",
        "files": [
          "upstream/lang/*.rs"
        ],
        "change": "Qualify the existing lazy_static::lazy_static! macro through hbb_common::lazy_static::lazy_static!.",
        "reason": "The existing hbb_common dependency reexports lazy_static. No new Cargo dependency or crate-level compatibility alias is needed. All other catalogue bytes, including BOMs and original strings, are unchanged."
      },
      {
        "id": "I18N2",
        "files": [
          "upstream/lang.rs"
        ],
        "change": "Read the existing crate::client_compat::APP_NAME constant in place of crate::is_rustdesk() and crate::get_app_name(), using the borrowed static name directly.",
        "reason": "The FRB owner already defines the product name as RustDesk. Preserve the exact official equality guard, replacement exclusions, and protection against duplicating an already-substituted brand; do not invent application APIs or allocate an owned brand name."
      },
      {
        "id": "I18N3",
        "files": [
          "upstream/lang.rs"
        ],
        "change": "Make cjk_ui_unavailable depend on Linux/aarch64 without the upstream feature=\"flutter\" clause.",
        "reason": "This crate is intrinsically the Flutter bridge and declares no optional flutter feature. Keep the pinned Flutter target restriction effective without introducing a meaningless Cargo feature. Windows and other target behavior is unchanged."
      },
      {
        "id": "I18N4",
        "files": [
          "upstream/lang.rs"
        ],
        "change": "Remove the unused translate(String) entrypoint which queries sys_locale; retain translate_locale(String, &str).",
        "reason": "The official consumer already supplies its locale to the bridge contract. No caller requires native system-locale discovery, so no sys-locale dependency is added."
      },
      {
        "id": "I18N5",
        "files": [
          "upstream/lang.rs"
        ],
        "change": "Omit the upstream mod test block from the compiled import; record its exact removal in integration.patch.",
        "reason": "Do not transplant or run the original project test suite. Reverse patch verification still recovers the complete original blob."
      },
      {
        "id": "I18N6",
        "files": [
          "upstream/lang.rs"
        ],
        "change": "Extract translate_locale_with_preference(name, locale, saved_lang) around the existing resolver and translation body; translate_locale still reads LocalConfig::get_option(\"lang\") and delegates to it.",
        "reason": "The Windows connection-manager process must translate using the authenticated main process's read-only language projection instead of its own LocalConfig. The explicit-preference entry does not access LocalConfig; both entrypoints reuse the same resolver, match table, fallback, placeholder and branding rules without a new dictionary or dependency."
      }
    ]
  },
  "interface": {
    "mount": "mod localization;",
    "signatures": [
      "pub fn langs() -> Vec<(&'static str, String)>",
      "pub fn translate_locale(name: String, locale: &str) -> String",
      "pub fn translate_locale_with_preference(name: String, locale: &str, saved_lang: &str) -> String"
    ],
    "official_consumer_calls": [
      "serde_json::to_string(&crate::localization::langs())",
      "crate::localization::translate_locale(name, &locale)",
      "crate::localization::translate_locale_with_preference(name, &locale, &saved_lang)"
    ],
    "dependencies": {
      "hbb_common": "Existing native/frb dependency; config::LocalConfig, regex::Regex and lazy_static::lazy_static! reexports are used.",
      "crate::client_compat::APP_NAME": "Existing pub(crate) static product-name constant; currently RustDesk."
    },
    "new_cargo_dependencies": []
